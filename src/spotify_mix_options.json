{
  "version": 1,
  "about": "Model of Spotify's Mix transition editor (Beta, Oct 2026). Curves traced from 20 editor screenshots in docs/screenshots. 'seen': true = shape measured from a screenshot; false = inferred from the option name, verify in calibration. Edit this file to recalibrate; no code changes needed.",
  "schema": {
    "u": "Position across the transition window, 0 = start, 1 = end. May also be a string 'end-Nbar' or 'start+Nbar', resolved with the window length in bars.",
    "point": "[u, value] or [u, value, ease]. 'ease' shapes the segment that ENDS at this point: linear (default) | smoothstep | equal_power | step.",
    "volume": "gain 0..1 (1 = full volume)",
    "eq": "per-band gain 0..1 for bands low/mid/high (1 = normal, 0 = killed). Missing band = constant 1.",
    "filter": "f in -1..1. 0 = off, +1 = high-pass at maximum, -1 = low-pass at maximum.",
    "effects": "Applied to song A only. 'wet' curve 0..1. 'beats' = echo/delay time in beats. 'tail': 'cut' stops at the window end, 'out' rings on after it.",
    "lanes": "A = outgoing song (top half of the editor), B = incoming song (bottom half). A missing lane = neutral (volume 1 for A before/after handled by renderer, eq 1, filter 0)."
  },
  "params": {
    "window": {"default_bars": 8, "allowed_bars": [2, 4, 8, 16], "calibrated": false,
               "note": "Writers report 2/4/8 bars; verify in the ••• menu or near the waveforms."},
    "beatmatch": {"enabled": true, "ramp_bars_after": 4, "calibrated": false},
    "eq": {"low_xover_hz": 200, "high_xover_hz": 2500, "kill_db": -40},
    "filter": {"hpf_max_hz": 1500, "lpf_min_hz": 250, "scale": "log"},
    "echo": {"feedback": 0.55, "wet_max": 0.6},
    "delay": {"feedback": 0.2, "wet_max": 0.5},
    "reverb": {"room_size": 0.8, "damping": 0.5, "wet_max": 0.5, "tail_s": 4.0},
    "loop": {"applies_to": "A", "source": "last_n_beats_before_window_end", "calibrated": false}
  },
  "volume": {
    "smooth_crossfade": {"label": "Smooth crossfade", "seen": true,
      "A": [[0, 1], [1, 0, "smoothstep"]], "B": [[0, 0], [1, 1, "smoothstep"]]},
    "overlap": {"label": "Overlap", "seen": true,
      "A": [[0, 1], [0.995, 1], [1, 0]], "B": [[0, 0], [0.005, 1], [1, 1]]},
    "fade_in_fade_out": {"label": "Fade in fade out", "seen": true,
      "A": [[0, 1], [0.5, 1], [1, 0]], "B": [[0, 0], [0.48, 1], [1, 1]]},
    "cut_in_fade_out": {"label": "Cut in fade out", "seen": false,
      "A": [[0, 1], [1, 0]], "B": [[0, 0], [0.005, 1], [1, 1]]},
    "fade_in_cut_out": {"label": "Fade in cut out", "seen": true,
      "A": [[0, 1], [0.995, 1], [1, 0]], "B": [[0, 0], [0.48, 1], [1, 1]]},
    "centre_cut": {"label": "Centre cut", "seen": true,
      "A": [[0, 1], [0.5, 1], [0.53, 0], [1, 0]], "B": [[0, 0], [0.47, 0], [0.5, 1], [1, 1]]},
    "crossfade": {"label": "Crossfade", "seen": false,
      "A": [[0, 1], [1, 0]], "B": [[0, 0], [1, 1]]},
    "fade_in_fast_out": {"label": "Fade in fast out", "seen": false,
      "A": [[0, 1], [0.5, 1], [0.65, 0], [1, 0]], "B": [[0, 0], [0.5, 1], [1, 1]]},
    "fade_in_1_bar_cut_out": {"label": "Fade in 1 bar cut-out", "seen": false,
      "A": [[0, 1], ["end-1bar", 1], [1, 0]], "B": [[0, 0], [0.5, 1], [1, 1]]},
    "overlap_1_bar_cut_out": {"label": "Overlap 1 bar cut-out", "seen": false,
      "A": [[0, 1], ["end-1bar", 1], [1, 0]], "B": [[0, 0], [0.005, 1], [1, 1]]}
  },
  "eq": {
    "centre_bass_swap": {"label": "Centre bass swap", "seen": true,
      "A": {"low": [[0, 1], [0.475, 1], [0.5, 0, "smoothstep"], [1, 0]]},
      "B": {"low": [[0, 0], [0.475, 0], [0.5, 1, "smoothstep"], [1, 1]]}},
    "end_bass_swap": {"label": "End bass swap", "seen": true,
      "A": {"low": [[0, 1], [0.965, 1], [0.998, 0, "smoothstep"], [1, 0]]},
      "B": {"low": [[0, 0], [0.965, 0], [0.998, 1, "smoothstep"], [1, 1]]}},
    "start_bass_swap": {"label": "Start bass swap", "seen": false,
      "A": {"low": [[0, 1], [0.03, 0, "smoothstep"], [1, 0]]},
      "B": {"low": [[0, 0], [0.03, 1, "smoothstep"], [1, 1]]}},
    "three_band_fade": {"label": "3-band fade", "seen": true,
      "A": {"low": [[0, 1], [0.475, 1], [0.5, 0, "smoothstep"], [1, 0]],
            "mid": [[0, 1], [0.5, 0.4, "smoothstep"], [1, 0.4]],
            "high": [[0, 1], [1, 0.4, "smoothstep"]]},
      "B": {"low": [[0, 0], [0.475, 0], [0.5, 1, "smoothstep"], [1, 1]],
            "mid": [[0, 0.4], [0.48, 1, "smoothstep"], [1, 1]],
            "high": [[0, 0.4], [0.85, 1, "smoothstep"], [1, 1]]}},
    "quick_bass_cut": {"label": "Quick bass cut", "seen": false,
      "A": {"low": [[0, 1], [0.1, 0, "smoothstep"], [1, 0]]}, "B": {}},
    "long_bass_cut": {"label": "Long bass cut", "seen": false,
      "A": {"low": [[0, 1], [1, 0]]}, "B": {}},
    "bass_fade_out": {"label": "Bass fade out", "seen": false,
      "A": {"low": [[0, 1], [0.25, 1], [1, 0, "smoothstep"]]}, "B": {}},
    "none": {"label": "None", "seen": true, "A": {}, "B": {}}
  },
  "filter": {
    "none": {"label": "None", "seen": true},
    "lpf_out": {"label": "Low-pass filter out", "seen": false,
      "A": [[0, 0], [0.5, 0], [1, -1]]},
    "lpf_in": {"label": "Low-pass filter in", "seen": false,
      "B": [[0, -1], [0.5, 0], [1, 0]]},
    "lpf_in_lpf_out": {"label": "Low-pass filter in low-pass filter out", "seen": true,
      "A": [[0, 0], [0.5, 0], [1, -1]], "B": [[0, -1], [0.5, 0], [1, 0]]},
    "lpf_in_hpf_out": {"label": "Low-pass filter in high-pass filter out", "seen": true,
      "A": [[0, 0], [0.5, 0], [1, 1]], "B": [[0, -1], [0.5, 0], [1, 0]]},
    "hpf_out": {"label": "High-pass filter out", "seen": false,
      "A": [[0, 0], [0.5, 0], [1, 1]]},
    "hpf_in": {"label": "High-pass filter in", "seen": false,
      "B": [[0, 1], [0.5, 0], [1, 0]]},
    "hpf_in_hpf_out": {"label": "High-pass filter in high-pass filter out", "seen": true,
      "A": [[0, 0], [0.5, 0], [1, 1]], "B": [[0, 1], [0.5, 0], [1, 0]]},
    "hpf_in_lpf_out": {"label": "High-pass filter in low-pass filter out", "seen": false,
      "A": [[0, 0], [0.5, 0], [1, -1]], "B": [[0, 1], [0.5, 0], [1, 0]]},
    "hpf_half_out": {"label": "High-pass filter half-out", "seen": true,
      "A": [[0, 0], [0.5, 0], [1, 0.54]]}
  },
  "effects": {
    "none": {"label": "None", "seen": true},
    "reverb_out_centre": {"label": "Reverb out centre", "seen": true,
      "type": "reverb", "tail": "out", "wet": [[0, 0], [0.5, 1], [1, 1]]},
    "reverb_cut_end": {"label": "Reverb cut end", "seen": false,
      "type": "reverb", "tail": "cut", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "reverb_out_end": {"label": "Reverb out end", "seen": false,
      "type": "reverb", "tail": "out", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "echo_half_cut_end": {"label": "Echo ½ cut end", "seen": false,
      "type": "echo", "beats": 0.5, "tail": "cut", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "echo_half_out_end": {"label": "Echo ½ out end", "seen": true,
      "type": "echo", "beats": 0.5, "tail": "out", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "echo_three_quarter_cut_end": {"label": "Echo ¾ cut end", "seen": false,
      "type": "echo", "beats": 0.75, "tail": "cut", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "echo_three_quarter_out_end": {"label": "Echo ¾ out end", "seen": false,
      "type": "echo", "beats": 0.75, "tail": "out", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "echo_one_cut_end": {"label": "Echo 1 cut end", "seen": false,
      "type": "echo", "beats": 1.0, "tail": "cut", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "echo_one_out_end": {"label": "Echo 1 out end", "seen": false,
      "type": "echo", "beats": 1.0, "tail": "out", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "delay_half_cut_end": {"label": "Delay ½ cut end", "seen": false,
      "type": "delay", "beats": 0.5, "tail": "cut", "wet": [[0, 0], [0.42, 0], [1, 1]]},
    "delay_three_quarter_cut_end": {"label": "Delay ¾ cut end", "seen": false,
      "type": "delay", "beats": 0.75, "tail": "cut", "wet": [[0, 0], [0.42, 0], [1, 1]]}
  },
  "loop": {
    "none": {"label": "None", "seen": true},
    "beat_1": {"label": "1-beat loop", "beats": 1, "seen": false},
    "beat_2": {"label": "2-beat loop", "beats": 2, "seen": false},
    "beat_4": {"label": "4-beat loop", "beats": 4, "seen": false},
    "beat_8": {"label": "8-beat loop", "beats": 8, "seen": false},
    "beat_16": {"label": "16-beat loop", "beats": 16, "seen": false}
  },
  "presets": {
    "auto": {"label": "Auto", "note": "Spotify chooses. Approximate as 'fade' when used as a baseline."},
    "fade": {"label": "Fade", "seen": true, "volume": "smooth_crossfade", "eq": "centre_bass_swap", "filter": "none", "effect": "none", "loop": "none"},
    "rise": {"label": "Rise", "seen": true, "volume": "overlap", "eq": "end_bass_swap", "filter": "lpf_in_hpf_out", "effect": "none", "loop": "none"},
    "blend": {"label": "Blend", "seen": true, "volume": "overlap", "eq": "three_band_fade", "filter": "none", "effect": "none", "loop": "none"},
    "wave": {"label": "Wave", "seen": true, "volume": "overlap", "eq": "centre_bass_swap", "filter": "lpf_in_lpf_out", "effect": "none", "loop": "none"},
    "melt": {"label": "Melt", "seen": true, "volume": "fade_in_fade_out", "eq": "centre_bass_swap", "filter": "hpf_in_hpf_out", "effect": "none", "loop": "none"},
    "slam": {"label": "Slam", "seen": true, "volume": "centre_cut", "eq": "none", "filter": "none", "effect": "none", "loop": "none"},
    "dissolve": {"label": "Dissolve", "seen": true, "volume": "fade_in_cut_out", "eq": "end_bass_swap", "filter": "hpf_half_out", "effect": "echo_half_out_end", "loop": "none"},
    "surge": {"label": "Surge", "seen": false, "volume": null, "eq": null, "filter": null, "effect": null, "loop": null,
              "note": "Not captured yet. Excluded from recommendations until calibrated."},
    "afterglow": {"label": "Afterglow", "seen": true, "volume": "smooth_crossfade", "eq": "centre_bass_swap", "filter": "none", "effect": "reverb_out_centre", "loop": "none"}
  }
}
